{
	"name": "@choros/cli",
	"version": "1.25.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "dotenv -e ../../.env -o -- sh -c 'exec env SUPERSET_API_URL=$NEXT_PUBLIC_API_URL cli-framework dev \"$@\"' --",
		"build": "cli-framework build",
		"build:darwin-arm64": "cli-framework build --target=bun-darwin-arm64 --outfile=./dist/choros-darwin-arm64",
		"build:linux-x64": "cli-framework build --target=bun-linux-x64 --outfile=./dist/choros-linux-x64",
		"build:all": "bun run build:darwin-arm64 && bun run build:linux-x64",
		"build:dist": "bun run scripts/build-dist.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@choros/cli-framework": "workspace:*",
		"@choros/host-service": "workspace:*",
		"@choros/i18n": "workspace:*",
		"@choros/local-db": "workspace:*",
		"@choros/shared": "workspace:*",
		"@choros/trpc": "workspace:*",
		"@clack/prompts": "0.10.1",
		"@trpc/client": "11.16.0",
		"date-fns": "4.1.0",
		"drizzle-orm": "0.45.2",
		"ink": "7.0.1",
		"mime-types": "3.0.2",
		"react": "19.2.3",
		"superjson": "2.2.6"
	},
	"devDependencies": {
		"@choros/typescript": "workspace:*",
		"@types/mime-types": "3.0.1",
		"@types/react": "19.2.14",
		"bun-types": "1.3.14",
		"typescript": "6.0.3"
	}
}
